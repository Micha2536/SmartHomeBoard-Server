# Optionale USB-Geräte. Immer den stabilen Pfad aus /dev/serial/by-id verwenden.
# ENOCEAN_DEVICE=/dev/serial/by-id/usb-EnOcean_GmbH_EnOcean_USB_300_DB_SERIENNUMMER-if00-port0
ZWAVE_DEVICE=/dev/serial/by-id/ZWAVE_STICK_PFAD_EINTRAGEN

# Für die Anmeldung an der lokalen Z-Wave-JS-UI. Vor dem Einsatz ersetzen.
ZWAVE_SESSION_SECRET=BITTE_DURCH_EINE_LANGE_ZUFAELLIGE_ZEICHENFOLGE_ERSETZEN

# Optional: Apple Push Notification Service.
# SHB_APNS_TEAM_ID=
# SHB_APNS_KEY_ID=
# SHB_APNS_BUNDLE_ID=Michael.SmartHomeBoard
# SHB_APNS_KEY_PATH=/run/secrets/AuthKey.p8
